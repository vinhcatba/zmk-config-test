#include <behaviors.dtsi>
#include <behaviors/bt_profile_led.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define DEFAULT 0
#define BT 1
#define BT_CLEAR 2
#define SCROLL 3

/ {
    behaviors {
        // Behaviour to cycle through DPI values on a keypress
        dpi_cycle: sensor_dpi_cycle {
            compatible = "zmk,behavior-sensor-attr-cycle";
            #binding-cells = <1>;
            values = < 400 600 1000 >;
            attr = <0>;
            sensor_device = <&trackball>;
            display-name = "DPI cycle";
            persistant;
        };

        fn_dpi: fn_dpi {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&dpi_cycle>;
        };

        bt_scroll: bt_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------
            // |     Z     |
            // |     A     |
            // |     D     |
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &fn_dpi BT 1
            >;
        };

        bt_layer { // Layer 1 (Hold FN)
            bindings = <
                &bt_scroll BT_CLEAR SCROLL
                &bt BT_NXT
                &trans
            >;
        };

        bt_clear_layer { // Layer 2 (Hold FN + Hold left key)
            bindings = <
                &trans
                &bt_clr_all_led
                &trans
            >;
        };

        scroll_layer { // Layer 3 (Hold FN + Tap left key)
            bindings = <
                &trans
                &trans
                &trans
            >;
        };
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 16>;
    };
};