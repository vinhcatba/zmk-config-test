DT_COMPAT_ZMK_BEHAVIOR_SENSOR_ATTR_SET := zmk,behavior-sensor-attr-set
DT_COMPAT_ZMK_BEHAVIOR_SCROLL_SCALER := zmk,behavior-scroll-scaler
DT_COMPAT_ZMK_INPUT_PROCESSOR_SCROLL_SCALER_DYN := zmk,input-processor-scroll-scaler-dyn

config ZMK_BEHAVIOR_SENSOR_ATTR_SET
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_SENSOR_ATTR_SET))
    imply SETTINGS

config ZMK_BEHAVIOR_SCROLL_SCALER
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_SCROLL_SCALER))
    imply SETTINGS

config ZMK_INPUT_PROCESSOR_SCROLL_SCALER_DYN
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_SCROLL_SCALER_DYN))
